{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ojuny-project.github.io/schemas/acceptance-inventory.json",
  "title": "Ojuny acceptance inventory",
  "type": "object",
  "required": ["version", "flows"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "screen", "strings", "manual", "status"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "screen": {
            "type": "string",
            "minLength": 1
          },
          "strings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "manual": {
            "type": "boolean"
          },
          "status": {
            "enum": ["draft", "active"]
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
